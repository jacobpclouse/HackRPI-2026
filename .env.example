# Copy to .env for local runs. Every variable is optional; integrations stay
# off when unset. backend/darkwatch/config.py is the only module that reads these.

# --- server ---
# Local port. Default 8741.
PORT=
# Set by Databricks Apps; wins over PORT when present.
DATABRICKS_APP_PORT=
# Absolute repo root, if auto-discovery (the .darkwatch-root marker) fails.
DARKWATCH_ROOT=

# --- globe ---
# Cesium ion token. Unset: Esri World Imagery or OSM, no ion assets.
CESIUM_ION_TOKEN=

# --- briefs (Google Gemini) ---
# Rewrites the unmatched-detection brief. Unset: local template with the real numbers.
GEMINI_API_KEY=
# Default gemini-2.5-flash.
GEMINI_MODEL=

# --- narration (Fish Audio) ---
# MP3 narration. Unset: the browser speech voice, labeled as such.
FISH_AUDIO_API_KEY=
# Voice reference_id. Default is Aria, a public library voice:
# FISH_AUDIO_VOICE_ID=933563129e564b19a115bedd57b7406a
FISH_AUDIO_VOICE_ID=
# Model header. Default s2.1-pro-free.
FISH_AUDIO_MODEL=

# --- storage ---
# Tiger Data / TimescaleDB Postgres URL. Unset: DuckDB at data/cache/darkwatch.duckdb.
TIGER_DATABASE_URL=
# Unity Catalog catalog and schema the app reads from the SQL warehouse.
DARKWATCH_CATALOG=
DARKWATCH_SCHEMA=
# SQL warehouse id. Used only together with DATABRICKS_HOST.
DATABRICKS_WAREHOUSE_ID=
# Injected by Databricks Apps (with DATABRICKS_CLIENT_ID / _SECRET, read by the SDK).
DATABRICKS_HOST=

# --- validation and context ---
# Global Fishing Watch API token for /api/validation/gfw.
GFW_API_TOKEN=
# GFW dataset id. Default public-global-sar-presence:latest.
GFW_DATASET=
# Protected Planet token for backend/scripts/fetch_mpas.py.
WDPA_API_TOKEN=

# --- detector seam ---
# Both must be set to swap CA-CFAR for an xView3 model adapter.
XVIEW3_WEIGHTS=
XVIEW3_REPO=

# --- make prepare ---
# Path to an already-downloaded Danish AIS zip. Default data/raw/aisdk-2026-11-02.zip.
AIS_ZIP=
